# OS metadata and temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.stackdump

# Logs and runtime dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# PROTOTYPES & MOCKUPS POLICY: NEVER COMMIT BUILDS / PROTOTYPES
# This repository is strictly for Business Analysis, Specifications & Documentation.
# All prototype builds, mockups, bundles, and local test runtimes are completely ignored.
# ==============================================================================
prototypes/*
!prototypes/.gitkeep
mockups/*
!mockups/.gitkeep
dist/
build/
out/
.next/
.nuxt/
.output/
.parcel-cache/
node_modules/

# Scratch and temporary work notes
scratch/*
!scratch/.gitkeep

# IDE and editor settings (keep .agents committed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment & local secrets
.env
.env.local
.env.*.local
credentials.json
!web-app-uat-skill/templates/credentials.json

# Test and coverage outputs
coverage/
.pytest_cache/
__pycache__/
*.pyc

# ==============================================================================
# NDA & CONFIDENTIAL DOCUMENTATION PROTECTION (LOCAL INPUTS ONLY)
# Never commit raw company/client inputs, signed documents, or heavy binary files.
# ==============================================================================
docs/inputs/*
!docs/inputs/.gitkeep
docs/templates/*.docx
docs/templates/*.pdf
*.docx
*.pdf
use-case-writer-main/
user-story-ac-writer-main/

