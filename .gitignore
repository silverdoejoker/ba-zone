# OS metadata and temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.stackdump

# Logs and runtime dumps
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==============================================================================
# PROTOTYPES & MOCKUPS POLICY: NEVER COMMIT BUILDS / PROTOTYPES
# This repository is strictly for Business Analysis, Specifications & Documentation.
# All prototype builds, mockups, bundles, and local test runtimes are completely ignored.
# ==============================================================================
prototypes/*
!prototypes/.gitkeep
mockups/*
!mockups/.gitkeep
dist/
build/
out/
.next/
.nuxt/
.output/
.parcel-cache/
node_modules/

# Scratch and temporary work notes
scratch/*
!scratch/.gitkeep

# IDE and editor settings (keep .agents committed)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment & local secrets
.env
.env/
.env/*
.env.local
.env.*.local
credentials.json
!web-app-uat-skill/templates/credentials.json

# Test and coverage outputs
coverage/
.pytest_cache/
__pycache__/
*.pyc

artifacts/*
!artifacts/.gitkeep

# ==============================================================================
# NDA & CONFIDENTIAL CLIENT DOCUMENTATION (LOCAL WORKING ONLY - NEVER COMMIT)
# Strict policy: "Generalize by default, specialize only on export" (Zero Leakage)
# ==============================================================================
# Raw incoming client documents, contracts, signed specifications
docs/inputs/*
!docs/inputs/.gitkeep

# Local generated client reports, agendas, checklists & outputs
docs/outputs/*
!docs/outputs/.gitkeep

# Specific client project workspaces & internal implementation artifacts
docs/projects/*
!docs/projects/.gitkeep

# Client-specific patterns & working files
docs/*NLE*
docs/**/*NLE*
docs/*Clarification*
docs/**/*Clarification*
docs/*URD*
docs/**/*URD*
docs/*LEASING*
docs/**/*LEASING*
docs/*TRAINING*
docs/**/*TRAINING*
docs/*TAS*
docs/**/*TAS*

# Office binaries, PDFs, and drawing files (never commit raw client binaries)
*.docx
*.doc
*.pdf
*.xlsx
*.xls
*.pptx
*.ppt
*.vsdx

# Sub-repositories and legacy working archives
use-case-writer-main/
user-story-ac-writer-main/

