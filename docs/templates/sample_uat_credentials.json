{
  "target_url": "https://uat.example.com",
  "environment": "uat",
  "description": "Cấu hình tài khoản kiểm thử UAT an toàn (Không commit mật khẩu thật lên Git)",
  "timeout_seconds": 5,
  "headless": true,
  "accounts": [
    {
      "role": "admin",
      "display_name": "System Administrator",
      "username": "admin_uat@example.com",
      "password": "ENCRYPTED_OR_TEST_SECRET",
      "totp_secret": null,
      "expected_landing_path": "/dashboard/admin"
    },
    {
      "role": "landlord",
      "display_name": "Chủ Nhà Trọ (Owner)",
      "username": "chutro_demo@example.com",
      "password": "ENCRYPTED_OR_TEST_SECRET",
      "totp_secret": null,
      "expected_landing_path": "/app/dashboard"
    },
    {
      "role": "tenant",
      "display_name": "Khách Thuê Phòng (Tenant)",
      "username": "khachthue_demo@example.com",
      "password": "ENCRYPTED_OR_TEST_SECRET",
      "totp_secret": null,
      "expected_landing_path": "/portal/my-room"
    }
  ],
  "viewports": [
    { "name": "Desktop Full HD", "width": 1920, "height": 1080 },
    { "name": "Tablet Portrait", "width": 768, "height": 1024 },
    { "name": "Mobile Standard", "width": 375, "height": 667 }
  ],
  "manual_hardware_checks": [
    "Camera OCR Scanner",
    "Google Play Billing",
    "Storage Access Framework (SAF)"
  ]
}
